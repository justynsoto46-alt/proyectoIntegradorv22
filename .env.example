# Copie este archivo como .env y complete los valores.
# El archivo .env NUNCA debe subirse al repositorio.

# Puerto en el que se levanta la aplicación
PORT=3000

# Nombre de la base de datos en MongoDB Atlas
DB_NAME=eventos

# Cadena de conexión de MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:contrasenia@cluster.mongodb.net/?retryWrites=true&w=majority
