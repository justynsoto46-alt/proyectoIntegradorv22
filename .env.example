# Copie este archivo como .env y complete los valores.
# El archivo .env NUNCA debe subirse al repositorio.

# Puerto en el que se levanta la aplicación
PORT=3000

# Nombre de la base de datos en MongoDB Atlas
DB_NAME=eventos

# Cadena de conexión de MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:contrasenia@cluster.mongodb.net/?retryWrites=true&w=majority

# Dirección base de la aplicación.
# Se utiliza para construir el enlace del correo de activación.
APP_URL=http://localhost:3000

# ---------- GEMINI ----------
# Clave de la API de Google Gemini (Google AI Studio)
GEMINI_API_KEY=PEGUE_AQUI_SU_CLAVE

# Modelo de Gemini que se utilizará
GEMINI_MODEL=gemini-3.6-flash

# ---------- CORREO ELECTRONICO (SMTP) ----------
# Para Gmail debe usar una CONTRASEÑA DE APLICACIÓN,
# no la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=PEGUE_AQUI_LA_CUENTA
SMTP_PASSWORD=PEGUE_AQUI_LA_CLAVE_DE_APLICACION
EMAIL_FROM=PEGUE_AQUI_LA_CUENTA
